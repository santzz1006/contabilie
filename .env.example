# Required in production; use a long random secret (32+ bytes).
AUTH_SECRET=

# Password reset email (Resend). Without these, reset returns a clear setup error.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_BASE_URL=http://localhost:3000

# Local JSON repository path. Replace with a database adapter for hosted deployments.
CONTABILIS_DB_PATH=./data/store.json
